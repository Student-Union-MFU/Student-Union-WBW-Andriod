<?xml version="1.0" encoding="utf-8"?>
<!--
  The dev backend is plain http on the host machine (10.0.2.2 from the emulator,
  or a LAN IP from a device). Production uses https. Cleartext is allowed only
  for local dev hosts so a misconfigured release can't silently talk http.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
    </domain-config>
</network-security-config>
