<?xml version="1.0" encoding="utf-8"?>
<!--
  Release posture: https only, no exceptions. A misconfigured release build fails loudly
  instead of quietly shipping a participant's credentials in the clear.

  Local dev talks plain http, and that is handled by the debug-only override in
  `app/src/debug/res/xml/` — same filename, so the debug build type replaces this file
  wholesale and the release build never sees the relaxation.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
